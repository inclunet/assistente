{
  "name": "Perfil sintético 0.4.0",
  "description": "Fixture sem dados pessoais",
  "icon": "flask-outline",
  "chat": {
    "llm_provider": "provedor-sintetico",
    "model": "modelo-sintetico",
    "temperature": 0.1,
    "max_tokens": 4096,
    "top_p": 1,
    "response_timeout": 180,
    "tool_policy_default": "disabled",
    "tool_policy": {
      "read_file": "preloaded",
      "grep_search": "on_demand",
      "text_edit": "disabled"
    },
    "enabled_skills": ["skill-base", "skill-opcional"],
    "rate_limit_enabled": true,
    "rate_limit_rpm": 24,
    "rate_limit_burst": 4
  },
  "voice": {
    "assistant": {"enabled": false, "provider": "disabled", "rate": 1, "pitch": 1, "volume": 1},
    "user": {"enabled": false, "provider": "disabled", "rate": 1, "pitch": 1, "volume": 1},
    "system": {"enabled": false, "provider": "disabled", "rate": 1, "pitch": 1, "volume": 1}
  },
  "input": {
    "enabled": false,
    "stt_provider": "webspeech",
    "language": "es",
    "feedback_sounds": false
  },
  "channels": {"response_mode": "mirror"}
}
