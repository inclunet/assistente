{
  "_builtin_version": "4.0.0",
  "name": "Editor de Texto",
  "description": "Perfil para edição dentro do editor de texto (sem ferramentas de filesystem).",
  "icon": "create-outline",
  "chat": {
    "llm_provider": "$default",
    "model": "$default",
    "temperature": 0.2,
    "max_tokens": 4096,
    "top_p": 1.0,
    "response_timeout": 180,
    "enable_thinking": false,
    "enabled_tools": ["text_edit"],
    "enabled_skills": ["workspace", "editor-texto"]
  },
  "voice": {
    "assistant": {
      "enabled": false,
      "provider": "disabled",
      "llm_provider_id": "$default",
      "rate": 1.0,
      "pitch": 1.0,
      "volume": 1.0
    },
    "user": {
      "enabled": false,
      "provider": "disabled",
      "rate": 1.0,
      "pitch": 1.0,
      "volume": 1.0
    },
    "system": {
      "enabled": false,
      "provider": "disabled",
      "rate": 1.0,
      "pitch": 1.0,
      "volume": 1.0
    }
  },
  "input": {
    "enabled": true,
    "stt_provider": "webspeech",
    "llm_provider_id": "$default",
    "language": "pt-BR",
    "feedback_sounds": true
  },
  "channels": {
    "response_mode": "mirror"
  }
}
