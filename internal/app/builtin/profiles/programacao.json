{
  "_builtin_version": "4.0.0",
  "name": "Programação",
  "description": "Otimizado para programação e código.",
  "icon": "code-slash-outline",
  "chat": {
    "llm_provider": "$default",
    "model": "$default",
    "temperature": 0,
    "max_tokens": 10000,
    "context_window": 128000,
    "max_context_messages": 80,
    "min_context_messages": 20,
    "top_p": 0,
    "response_timeout": 180,
    "enabled_tools": null,
    "enabled_skills": [
      "workspace",
      "coding",
      "memory",
      "prometheus"
    ]
  },
  "voice": {
    "assistant": {
      "enabled": false,
      "provider": "disabled",
      "llm_provider_id": "$default",
      "model": "tts-1",
      "rate": 1,
      "pitch": 1,
      "volume": 1
    },
    "user": {
      "enabled": false,
      "provider": "disabled",
      "rate": 1,
      "pitch": 1,
      "volume": 1
    },
    "system": {
      "enabled": false,
      "provider": "disabled",
      "rate": 1,
      "pitch": 1,
      "volume": 1
    }
  },
  "input": {
    "enabled": true,
    "stt_provider": "webspeech",
    "llm_provider_id": "$default",
    "language": "pt-BR",
    "feedback_sounds": true
  },
  "channels": {
    "response_mode": "mirror"
  }
}
