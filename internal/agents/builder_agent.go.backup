package agents

import (
	"context"
	"encoding/json"
	"fmt"

	"assistente/internal/agentmanager"
)

// BuilderAgent é um agente inteligente que cria e gerencia HTTP e MCP Agents
type BuilderAgent struct {
	BaseAgent
	manager agentmanager.Manager
}

// NewBuilderAgent cria um novo BuilderAgent inteligente
func NewBuilderAgent(manager agentmanager.Manager, llmClient LLMClient, model string) *BuilderAgent {
	if model == "" {
		model = "gpt-4o-mini" // Modelo padrão para agentes
	}

	return &BuilderAgent{
		BaseAgent: BaseAgent{
			Name:        "builder",
			DisplayName: "Agent Builder",
			Description: "Cria e gerencia agentes HTTP e MCP. Use para criar agentes a partir de OpenAPI, Postman, ou instruções naturais. Também gerencia endpoints e testa integrações.",
			AgentType:   "internal",
			Model:       model,
			SystemPrompt: `Você é um especialista em criar e gerenciar agentes HTTP e MCP.

## Suas capacidades:

### HTTP Agents:
- builder_create_http_agent: Criar agente HTTP completo com base_url, autenticação, etc.
- builder_get_http_agent: Obter detalhes de um agente HTTP por ID
- builder_list_http_agents: Listar todos os agentes HTTP
- builder_update_http_agent: Atualizar configuração de agente HTTP
- builder_delete_http_agent: Deletar agente HTTP
- builder_create_endpoint: Criar endpoint em agente HTTP existente
- builder_update_endpoint: Atualizar endpoint existente
- builder_delete_endpoint: Deletar endpoint
- builder_test_endpoint: Testar endpoint com parâmetros
- builder_import_openapi: Importar agente completo de especificação OpenAPI
- builder_import_postman: Importar agente de coleção Postman

### MCP Agents:
- builder_create_mcp_agent: Criar agente MCP (stdio ou http)
- builder_list_mcp_agents: Listar todos os agentes MCP
- builder_update_mcp_agent: Atualizar configuração de agente MCP
- builder_delete_mcp_agent: Deletar agente MCP

## Estratégia de Criação:

### Para criar HTTP Agent a partir de descrição natural:
1. Extraia: nome, URL base, tipo de autenticação (bearer/api-key/basic/none)
2. Pergunte ao usuário se algo estiver faltando
3. Crie o agente com builder_create_http_agent
4. Se houver endpoints mencionados, crie-os com builder_create_endpoint

### Para importar OpenAPI:
1. Use builder_import_openapi com o conteúdo YAML/JSON
2. Especifique nome e modelo (opcional)
3. O sistema criará automaticamente todos os endpoints

### Para importar Postman:
1. Use builder_import_postman com o JSON da coleção
2. Especifique nome e modelo (opcional)
3. O sistema criará automaticamente todos os endpoints

### Para criar MCP Agent:
1. stdio: Requer server_command (caminho do executável), server_args (opcional), server_env (opcional)
2. http: Requer server_url, opcionalmente auth_type/auth_value/http_headers

## Instruções:
1. Analise a tarefa do usuário
2. Identifique se é HTTP ou MCP, criação nova ou import
3. Execute as tools necessárias na ordem correta
4. Forneça feedback claro sobre o que foi criado
5. Se testar endpoint, interprete e explique os resultados

Seja claro e direto. Quando criar agente, confirme o ID criado para referência futura.`,
			Enabled: true,
			LLM:     llmClient,
		},
		manager: manager,
	}
}

// Execute recebe uma tarefa em linguagem natural e usa o LLM para decidir como resolver
func (a *BuilderAgent) Execute(ctx context.Context, task string) (string, error) {
	if a.LLM == nil {
		return "", fmt.Errorf("LLM client não configurado para o agente %s", a.Name)
	}

	fmt.Printf("🔨 [Builder Agent] Recebeu tarefa: %s\n", task)

	// Usa o método com saver se disponível
	var result string
	var err error
	if a.MessageSaver != nil {
		result, err = a.LLM.ChatWithToolsAndSaver(
			ctx,
			a.Model,
			a.SystemPrompt,
			task,
			a.GetTools(),
			a.ExecuteTool,
			a.Name,
			a.MessageSaver,
		)
	} else {
		result, err = a.LLM.ChatWithTools(
			ctx,
			a.Model,
			a.SystemPrompt,
			task,
			a.GetTools(),
			a.ExecuteTool,
			a.Name,
		)
	}

	if err != nil {
		return "", fmt.Errorf("erro na execução do Builder Agent: %w", err)
	}

	return result, nil
}

