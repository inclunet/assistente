      "volume": 1.0
    },
    "system": {
      "enabled": false,
      "provider": "disabled",
      "rate": 1.0,
      "pitch": 1.0,
      "volume": 1.0
    }
  },
  "input": {
    "enabled": true,
    "stt_provider": "webspeech",
