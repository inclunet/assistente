{
  "_builtin_version": "3.0.0",
  "name": "Programação",
  "description": "Otimizado para programação e código.",
  "icon": "code-slash-outline",
  "active": true,
  "chat": {
    "llm_provider": "$default",
    "model": "$default",
    "temperature": 0,
    "max_tokens": 10000,
    "context_window": 128000,
    "max_context_messages": 80,
    "min_context_messages": 20,
    "top_p": 0,
    "response_timeout": 180,
    "enabled_tools": null,
    "enabled_skills": [
      "coding",
      "memory",
      "prometheus"
    ]
  },
  "voice": {
    "provider": "disabled",
    "llm_provider_id": "$default",
    "rate": 1,
    "pitch": 1,
    "volume": 1,
    "enabled_for_agent": false,
    "enabled_for_user": false
  },
  "interaction": {
    "stt_provider": "webspeech",
    "llm_provider_id": "$default",
    "language": "pt-BR",
    "feedback_sounds": true
  }
}
